            "subline": {
              "type": "string",
              "maxLength": 300,
              "description": "New subline text."
            }
          },
          "required": [
            "frame_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_reel_products",
        "title": "List reel products",
        "description": "List products attached to reels you can see, with ids and stock status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "update_product_status",
        "title": "Set product stock status",
        "description": "Set a reel product to in stock, out of stock or unknown. Works for the brand's own members and staff. Sold-out products are hidden from shoppers.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "format": "uuid"
            },
            "availability": {
              "type": "string",
              "enum": [
                "in_stock",
                "out_of_stock",
                "unknown"
              ]
            }
          },
          "required": [
            "product_id",
            "availability"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "admin_approve_brand_request",
        "title": "Admin: approve a brand application",
        "description": "Staff only. Approve one pending brand application: creates its draft (unpublished) brand page and emails the applicant. Ask the user to confirm first.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": true
