{
  "version": 1,
  "sdk_version": "3.5.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://rrolsjupsqkdfhfhejmi.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "gravity-pants",
      "version": "0.2.0",
      "title": "Gravity Pants"
    },
    "tools": [
      {
        "name": "list_workspaces",
        "title": "List your workspaces",
        "description": "List accessible Gravity Pants workspaces to select an account for reading ads.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_ads",
        "title": "List workspace ads",
        "description": "Read non-deleted ads in an accessible workspace, newest first, with optional name search and pagination.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "workspace_id": {
              "type": "string",
              "format": "uuid",
              "description": "Workspace ID returned by list_workspaces."
            },
            "query": {
              "type": "string",
              "maxLength": 200,
              "description": "Optional ad name search."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0,
              "description": "Pagination offset."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum ads to return."
            }
          },
          "required": [
            "workspace_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "admin_overview",
        "title": "Admin: platform overview",
        "description": "Staff only. Platform totals: workspaces, paid plans, 30-day exports, recent workspaces, pending brand applications and open support tickets.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "admin_client_lookup",
        "title": "Admin: look up a client",
        "description": "Staff only. Find workspaces by name, id or member email and show plan, billing status and export allowance.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 120,
              "description": "Workspace name, workspace id or member email."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "admin_support_tickets",
        "title": "Admin: support tickets",
        "description": "Staff only. List recent support tickets with status, priority, topic, workspace and message excerpt.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "open",
                "resolved",
                "all"
              ],
              "default": "open",
              "description": "Open means anything not resolved."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "admin_brand_applications",
        "title": "Admin: brand applications and reel updates",
        "description": "Staff only. List brand applications awaiting review and live reel video replacements awaiting approval.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
